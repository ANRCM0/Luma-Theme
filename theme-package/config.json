{
  "name": "vv-theme",
  "version": "0.9.5",
  "description": "React live user portal for TXBoard",
  "author": "ANRCM0",
  "compatibility": {
    "txboard": "*"
  },
  "configs": [
    {
      "group": "品牌与外观",
      "label": "主题色",
      "field_name": "theme_color",
      "field_type": "select",
      "select_options": {
        "default": "默认青色",
        "blue": "蓝色",
        "darkblue": "深蓝色",
        "black": "黑色"
      },
      "default_value": "default"
    },
    {
      "group": "品牌与外观",
      "label": "背景图片 URL",
      "field_name": "background_url",
      "field_type": "input"
    },
    {
      "group": "页面布局",
      "label": "桌面端布局",
      "field_name": "layout_mode",
      "field_type": "select",
      "select_options": {
        "top": "顶部导航",
        "sidebar": "左侧边栏"
      },
      "default_value": "top",
      "description": "手机端始终使用底部导航，避免空间不足"
    },
    {
      "group": "页面布局",
      "label": "默认收起侧边栏",
      "field_name": "sidebar_collapsed_default",
      "field_type": "switch",
      "default_value": "0",
      "description": "仅在左侧边栏布局、桌面屏幕上生效"
    },
    {
      "group": "菜单与导航",
      "label": "菜单显示与排序",
      "field_name": "nav_items",
      "field_type": "navigation",
      "select_options": {
        "dashboard": "我的面板",
        "shop": "购买套餐",
        "profile": "账号设置",
        "ticket": "服务工单",
        "menu": "全部菜单",
        "orders": "我的订单"
      },
      "default_value": "dashboard,shop,profile,ticket,menu,!orders",
      "description": "取消勾选即隐藏导航项；我的面板与全部菜单始终保留"
    },
    {
      "group": "个性化欢迎",
      "label": "启用动态欢迎卡片",
      "field_name": "welcome_enabled",
      "field_type": "switch",
      "default_value": "1",
      "description": "根据真实用户订阅状态显示不同提示；关闭后使用通用欢迎文案"
    },
    {
      "group": "个性化欢迎",
      "label": "新用户判定时长（小时）",
      "field_name": "welcome_new_hours",
      "field_type": "number",
      "default_value": 48,
      "description": "只在尚未订阅时判定为新用户；0 关闭新用户窗口"
    },
    {
      "group": "个性化欢迎",
      "label": "即将到期提醒（小时）",
      "field_name": "welcome_expiry_hours",
      "field_type": "number",
      "default_value": 72,
      "description": "有有效订阅时，到期时间进入此范围提示续费"
    },
    {
      "group": "个性化欢迎",
      "label": "流量不足绝对阈值（GB）",
      "field_name": "welcome_low_traffic_gb",
      "field_type": "number",
      "default_value": 10,
      "description": "与百分比阈值取较小值；避免小流量套餐一直触发提醒"
    },
    {
      "group": "个性化欢迎",
      "label": "流量不足比例（%）",
      "field_name": "welcome_low_traffic_percent",
      "field_type": "number",
      "default_value": 10,
      "description": "剩余流量低于套餐额度的该比例时提示；与 GB 阈值取较小值"
    },
    {
      "group": "个性化欢迎",
      "label": "首页侧边卡片",
      "field_name": "welcome_secondary_card",
      "field_type": "select",
      "select_options": {
        "recommend": "推荐套餐",
        "usage": "流量使用概览",
        "wallet": "账户余额"
      },
      "default_value": "recommend"
    },
    {
      "group": "订单与支付",
      "label": "自动查询订单状态",
      "field_name": "payment_auto_check",
      "field_type": "switch",
      "default_value": "1",
      "description": "仅查询服务端状态，不会自动重试付款或创建订单"
    },
    {
      "group": "订单与支付",
      "label": "订单查询间隔（秒）",
      "field_name": "payment_poll_seconds",
      "field_type": "number",
      "default_value": 4,
      "description": "允许范围 4 至 15 秒；每次打开订单最多查询 20 次，避免无限请求"
    },
    {
      "group": "订阅管理",
      "label": "显示客户端导入引导",
      "field_name": "subscription_client_guide",
      "field_type": "switch",
      "default_value": "1",
      "description": "按设备展示对应客户端与导入步骤；复制链接和二维码始终可用"
    },
    {
      "group": "订阅管理",
      "label": "显示流量重置操作",
      "field_name": "subscription_reset_action",
      "field_type": "switch",
      "default_value": "1",
      "description": "仍需服务端确认有效订阅、当前套餐和重置价格"
    },
    {
      "group": "订阅管理",
      "label": "显示当前套餐续费入口",
      "field_name": "subscription_renew_action",
      "field_type": "switch",
      "default_value": "1",
      "description": "点选时实时查询服务端可续费套餐；禁用时仍可浏览套餐"
    },
    {
      "group": "订阅管理",
      "label": "显示下次重置时间",
      "field_name": "subscription_show_next_reset",
      "field_type": "switch",
      "default_value": "1"
    },
    {
      "group": "套餐商店",
      "label": "快捷购买预选周期",
      "field_name": "shop_default_period",
      "field_type": "select",
      "select_options": {
        "all": "全部周期",
        "month_price": "月付",
        "quarter_price": "季付",
        "half_year_price": "半年付",
        "year_price": "年付",
        "two_year_price": "两年付",
        "three_year_price": "三年付",
        "onetime_price": "一次性"
      },
      "default_value": "all"
    },
    {
      "group": "套餐商店",
      "label": "精选套餐 ID",
      "field_name": "shop_featured_ids",
      "field_type": "input",
      "default_value": "",
      "placeholder": "例如 1,3（留空不显示精选角标）",
      "description": "仅作为首页与商店的展示推荐，不影响订单权限或价格"
    },
    {
      "group": "套餐商店",
      "label": "允许套餐对比",
      "field_name": "shop_compare_enabled",
      "field_type": "switch",
      "default_value": "1"
    },
    {
      "group": "套餐商店",
      "label": "显示套餐描述",
      "field_name": "shop_show_description",
      "field_type": "switch",
      "default_value": "1"
    },
    {
      "group": "公告通知",
      "label": "自动弹窗",
      "field_name": "notice_popup_enabled",
      "field_type": "switch",
      "default_value": "1"
    },
    {
      "group": "公告通知",
      "label": "通知铃铛与公告中心",
      "field_name": "notice_center_enabled",
      "field_type": "switch",
      "default_value": "1"
    },
    {
      "group": "公告通知",
      "label": "自动弹窗标签",
      "field_name": "notice_popup_tag",
      "field_type": "input",
      "placeholder": "留空为全部，例如 important 或 popup，多个标签用逗号隔开",
      "default_value": ""
    },
    {
      "group": "公告通知",
      "label": "自动弹出频率",
      "field_name": "notice_popup_frequency",
      "field_type": "select",
      "select_options": {
        "once": "每版公告只提醒一次",
        "session": "同一浏览器会话一次",
        "daily": "每 24 小时提醒一次",
        "always": "每次打开页面提醒"
      },
      "default_value": "once"
    },
    {
      "group": "公告通知",
      "label": "自动弹出范围",
      "field_name": "notice_popup_scope",
      "field_type": "select",
      "select_options": {
        "all": "任意登录页后",
        "dashboard": "仅进入用户主页"
      },
      "default_value": "all"
    },
    {
      "group": "公告通知",
      "label": "弹窗视觉样式",
      "field_name": "notice_popup_style",
      "field_type": "select",
      "select_options": {
        "classic": "经典通知",
        "compact": "简洁通知",
        "feature": "强调通知"
      },
      "default_value": "classic"
    },
    {
      "group": "界面原子细节",
      "label": "内容密度",
      "field_name": "ui_density",
      "field_type": "select",
      "select_options": {
        "comfortable": "舒适",
        "compact": "紧凑"
      },
      "default_value": "comfortable"
    },
    {
      "group": "界面原子细节",
      "label": "卡片圆角（px）",
      "field_name": "ui_card_radius",
      "field_type": "number",
      "default_value": 16,
      "description": "范围 8–28，超出范围自动限幅"
    },
    {
      "group": "界面原子细节",
      "label": "显示英文小标题",
      "field_name": "ui_show_eyebrow",
      "field_type": "switch",
      "default_value": "1"
    },
    {
      "group": "界面原子细节",
      "label": "显示页面说明文字",
      "field_name": "ui_show_page_description",
      "field_type": "switch",
      "default_value": "1"
    },
    {
      "group": "界面原子细节",
      "label": "显示页脚",
      "field_name": "ui_show_footer",
      "field_type": "switch",
      "default_value": "1"
    },
    {
      "group": "界面原子细节",
      "label": "显示导航图标",
      "field_name": "ui_show_nav_icons",
      "field_type": "switch",
      "default_value": "1"
    },
    {
      "group": "界面原子细节",
      "label": "顶部主题切换",
      "field_name": "ui_show_theme_toggle",
      "field_type": "switch",
      "default_value": "1"
    },
    {
      "group": "界面原子细节",
      "label": "顶部退出按钮",
      "field_name": "ui_show_header_logout",
      "field_type": "switch",
      "default_value": "1",
      "description": "关闭后仍可通过全部菜单退出"
    },
    {
      "group": "界面原子细节",
      "label": "欢迎卡说明文字",
      "field_name": "ui_welcome_description",
      "field_type": "switch",
      "default_value": "1"
    },
    {
      "group": "界面原子细节",
      "label": "欢迎卡装饰图形",
      "field_name": "ui_welcome_decoration",
      "field_type": "switch",
      "default_value": "1"
    },
    {
      "group": "界面原子细节",
      "label": "首页订阅导入区域",
      "field_name": "ui_dashboard_subscription",
      "field_type": "switch",
      "default_value": "1",
      "description": "仅隐藏首页显示，不改变真实订阅或链接权限"
    },
    {
      "group": "页面可见性",
      "label": "购买套餐",
      "field_name": "page_shop_visible",
      "field_type": "switch",
      "default_value": "1",
      "description": "仅控制 Luma 展示；后端权限和功能开关仍然有效"
    },
    {
      "group": "页面可见性",
      "label": "账号设置",
      "field_name": "page_profile_visible",
      "field_type": "switch",
      "default_value": "1",
      "description": "仅控制 Luma 展示；后端权限和功能开关仍然有效"
    },
    {
      "group": "页面可见性",
      "label": "服务工单",
      "field_name": "page_ticket_visible",
      "field_type": "switch",
      "default_value": "1",
      "description": "仅控制 Luma 展示；后端权限和功能开关仍然有效"
    },
    {
      "group": "页面可见性",
      "label": "我的订单",
      "field_name": "page_orders_visible",
      "field_type": "switch",
      "default_value": "1",
      "description": "仅控制 Luma 展示；后端权限和功能开关仍然有效"
    },
    {
      "group": "页面可见性",
      "label": "节点列表",
      "field_name": "page_nodes_visible",
      "field_type": "switch",
      "default_value": "1",
      "description": "仅控制 Luma 展示；后端权限和功能开关仍然有效"
    },
    {
      "group": "页面可见性",
      "label": "流量记录",
      "field_name": "page_traffic_visible",
      "field_type": "switch",
      "default_value": "1",
      "description": "仅控制 Luma 展示；后端权限和功能开关仍然有效"
    },
    {
      "group": "页面可见性",
      "label": "帮助中心",
      "field_name": "page_knowledge_visible",
      "field_type": "switch",
      "default_value": "1",
      "description": "仅控制 Luma 展示；后端权限和功能开关仍然有效"
    },
    {
      "group": "页面可见性",
      "label": "邀请管理",
      "field_name": "page_invite_visible",
      "field_type": "switch",
      "default_value": "1",
      "description": "仅控制 Luma 展示；后端权限和功能开关仍然有效"
    },
    {
      "group": "页面可见性",
      "label": "礼品卡",
      "field_name": "page_gift_visible",
      "field_type": "switch",
      "default_value": "1",
      "description": "仅控制 Luma 展示；后端权限和功能开关仍然有效"
    },
    {
      "group": "套餐分组与卡片",
      "label": "展示周期订阅",
      "field_name": "shop_cycle_visible",
      "field_type": "switch",
      "default_value": "1"
    },
    {
      "group": "套餐分组与卡片",
      "label": "展示流量包订阅",
      "field_name": "shop_traffic_visible",
      "field_type": "switch",
      "default_value": "1"
    },
    {
      "group": "套餐分组与卡片",
      "label": "分组顺序",
      "field_name": "shop_section_order",
      "field_type": "select",
      "select_options": {
        "recurring": "周期订阅优先",
        "traffic": "流量包优先"
      },
      "default_value": "recurring"
    },
    {
      "group": "套餐分组与卡片",
      "label": "分组说明文字",
      "field_name": "shop_group_description",
      "field_type": "switch",
      "default_value": "1"
    },
    {
      "group": "套餐分组与卡片",
      "label": "周期精选套餐 ID",
      "field_name": "shop_cycle_featured_id",
      "field_type": "number",
      "default_value": 0,
      "description": "0 使用已有精选套餐配置"
    },
    {
      "group": "套餐分组与卡片",
      "label": "流量包精选套餐 ID",
      "field_name": "shop_traffic_featured_id",
      "field_type": "number",
      "default_value": 0,
      "description": "0 使用已有精选套餐配置"
    },
    {
      "group": "套餐分组与卡片",
      "label": "周期卡片特性条数",
      "field_name": "shop_cycle_feature_limit",
      "field_type": "number",
      "default_value": 0,
      "description": "0 全部显示；最多 20 条"
    },
    {
      "group": "套餐分组与卡片",
      "label": "流量包特性条数",
      "field_name": "shop_traffic_feature_limit",
      "field_type": "number",
      "default_value": 0,
      "description": "0 全部显示；最多 20 条"
    },
    {
      "group": "套餐分组与卡片",
      "label": "显示套餐标签",
      "field_name": "shop_tags_visible",
      "field_type": "switch",
      "default_value": "1"
    },
    {
      "group": "套餐分组与卡片",
      "label": "显示套餐权益",
      "field_name": "shop_features_visible",
      "field_type": "switch",
      "default_value": "1"
    },
    {
      "group": "套餐分组与卡片",
      "label": "显示年付节省提示",
      "field_name": "shop_year_savings_visible",
      "field_type": "switch",
      "default_value": "0",
      "description": "仅作为价格比较，不改写服务端订单金额"
    },
    {
      "group": "套餐分组与卡片",
      "label": "显示空套餐分组",
      "field_name": "shop_empty_sections_visible",
      "field_type": "switch",
      "default_value": "1"
    },
    {
      "group": "订阅导入细节",
      "label": "显示订阅链接",
      "field_name": "subscription_link_visible",
      "field_type": "switch",
      "default_value": "1"
    },
    {
      "group": "订阅导入细节",
      "label": "显示订阅二维码",
      "field_name": "subscription_qr_visible",
      "field_type": "switch",
      "default_value": "1"
    },
    {
      "group": "订阅导入细节",
      "label": "显示隐私提示",
      "field_name": "subscription_caution_visible",
      "field_type": "switch",
      "default_value": "1"
    },
    {
      "group": "客户端图标与目录",
      "label": "客户端目录模式",
      "field_name": "subscription_client_mode",
      "field_type": "select",
      "select_options": {
        "merge": "保留默认客户端并合并配置",
        "replace": "仅显示自定义配置客户端"
      },
      "default_value": "merge",
      "description": "默认保留 Clash 等预设；替换模式只显示 JSON 中列出的客户端"
    },
    {
      "group": "客户端图标与目录",
      "label": "自定义客户端列表 JSON",
      "field_name": "subscription_clients_json",
      "field_type": "textarea",
      "default_value": "",
      "description": "可修改默认客户端，新增/停用客户端并设置平台、顺序、图片、下载网址或自定义导入协议；请参考 docs/client-catalog.md"
    },
    {
      "group": "客户端图标与目录",
      "label": "客户端图片尺寸（px）",
      "field_name": "subscription_client_icon_size",
      "field_type": "number",
      "default_value": 30,
      "description": "图片长宽均为此值，限制 22 至 64 像素"
    },
    {
      "group": "客户端图标与目录",
      "label": "Clash 图标图片 URL",
      "field_name": "subscription_client_icon_clash",
      "field_type": "input",
      "default_value": "",
      "description": "HTTPS 图片 URL 或本站 /images/ 路径，留空使用默认字母图标"
    },
    {
      "group": "客户端图标与目录",
      "label": "Hiddify 图标图片 URL",
      "field_name": "subscription_client_icon_hiddify",
      "field_type": "input",
      "default_value": "",
      "description": "HTTPS 图片 URL 或本站 /images/ 路径，留空使用默认字母图标"
    },
    {
      "group": "客户端图标与目录",
      "label": "Sing-box 图标图片 URL",
      "field_name": "subscription_client_icon_sing_box",
      "field_type": "input",
      "default_value": "",
      "description": "HTTPS 图片 URL 或本站 /images/ 路径，留空使用默认字母图标"
    },
    {
      "group": "客户端图标与目录",
      "label": "Shadowrocket 图标图片 URL",
      "field_name": "subscription_client_icon_shadowrocket",
      "field_type": "input",
      "default_value": "",
      "description": "HTTPS 图片 URL 或本站 /images/ 路径，留空使用默认字母图标"
    },
    {
      "group": "客户端图标与目录",
      "label": "Quantumult X 图标图片 URL",
      "field_name": "subscription_client_icon_quantumult_x",
      "field_type": "input",
      "default_value": "",
      "description": "HTTPS 图片 URL 或本站 /images/ 路径，留空使用默认字母图标"
    },
    {
      "group": "客户端图标与目录",
      "label": "Surge 图标图片 URL",
      "field_name": "subscription_client_icon_surge",
      "field_type": "input",
      "default_value": "",
      "description": "HTTPS 图片 URL 或本站 /images/ 路径，留空使用默认字母图标"
    },
    {
